#!/usr/bin/env python3
"""Delete stale flywheel files, then install the latest.

Usage: scripts/flywheel-update <target-dir> [problem-name] [--dry-run] [--allow-dirty]
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "shared"))

from scaffold import update_main

if __name__ == "__main__":
    raise SystemExit(update_main())
